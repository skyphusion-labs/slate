{
  "name": "@skyphusion/slate",
  "version": "0.5.6",
  "private": false,
  "type": "module",
  "description": "Slate -- Vivijure Screenwriter's Assistant for Discord",
  "homepage": "https://vivijure.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/skyphusion-labs/slate.git"
  },
  "keywords": [
    "discord-bot",
    "screenwriting",
    "filmmaking",
    "vivijure",
    "llm",
    "storyboard",
    "ai-assistant"
  ],
  "scripts": {
    "bot": "node bot.mjs",
    "lint": "node --check bot.mjs",
    "test": "vitest run",
    "smoke:studio": "node scripts/studio-smoke.mjs",
    "prepublishOnly": "npm run lint && npm test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116",
    "discord.js": "^14"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@vitest/coverage-istanbul": "^4.1.10",
    "vitest": "^5.0.0"
  },
  "license": "AGPL-3.0-only",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "bin": {
    "slate": "bot.mjs"
  },
  "files": [
    "bot.mjs",
    "lib.mjs",
    "registry.mjs",
    "studio.mjs",
    "studio-api.mjs",
    "contract.mjs",
    "assets/**",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md",
    "slate.env.example"
  ]
}
